{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/parameter-fit-report.schema.json",
  "title": "RefAs evidence-bound parameter fit report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan", "planDigest", "ownerCapability", "scopeId", "sourceSha256", "baselineAssetSha256", "optimizer", "status", "stopReason", "evaluationCount", "baselineTrialId", "selectedTrialId", "objectiveImprovement", "trials", "policy", "reportDigest"],
  "properties": {
    "schema": {"const": "refas.parameter-fit-report/v1"},
    "plan": {"$ref": "parameter-fit-plan.schema.json"},
    "planDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "ownerCapability": {"const": "shape-reconstruction"},
    "scopeId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "sourceSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "baselineAssetSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "optimizer": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "seed", "populationSize", "evaluationBudget", "differentialWeight", "crossoverRate", "improvementTolerance", "patience", "initializationAttemptBudget"],
      "properties": {
        "algorithm": {"const": "differential-evolution"}, "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "populationSize": {"type": "integer", "minimum": 4}, "evaluationBudget": {"type": "integer", "minimum": 5},
        "differentialWeight": {"type": "number", "exclusiveMinimum": 0, "maximum": 2}, "crossoverRate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "improvementTolerance": {"type": "number", "minimum": 0}, "patience": {"type": "integer", "minimum": 1},
        "initializationAttemptBudget": {"type": "integer", "minimum": 1}
      }
    },
    "status": {"enum": ["IMPROVED", "NO_IMPROVEMENT"]},
    "stopReason": {"enum": ["evaluation-budget", "patience", "search-space-exhausted"]},
    "evaluationCount": {"type": "integer", "minimum": 1},
    "baselineTrialId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "selectedTrialId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "objectiveImprovement": {"type": "number"},
    "trials": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sequence", "phase", "generation", "parameters", "measurements", "decomposition", "objectiveLoss", "eligible", "protectedRegressions", "candidateAsset", "renderEvidence", "evidenceRefs"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/semanticId"}, "sequence": {"type": "integer", "minimum": 1},
          "phase": {"enum": ["baseline", "population", "evolution"]}, "generation": {"type": "integer", "minimum": 0},
          "parameters": {"type": "object", "additionalProperties": {"type": "number"}},
          "measurements": {"type": "object", "additionalProperties": {"type": "number"}},
          "decomposition": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "value", "contribution"], "properties": {"id": {"$ref": "common.schema.json#/$defs/semanticId"}, "value": {"type": "number"}, "contribution": {"type": "number"}}}},
          "objectiveLoss": {"type": "number"}, "eligible": {"type": "boolean"},
          "protectedRegressions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "baseline", "value", "regression", "maxRegression"], "properties": {"id": {"$ref": "common.schema.json#/$defs/semanticId"}, "baseline": {"type": "number"}, "value": {"type": "number"}, "regression": {"type": "number"}, "maxRegression": {"type": "number", "minimum": 0}}}},
          "candidateAsset": {"$ref": "common.schema.json#/$defs/contentReference"}, "renderEvidence": {"$ref": "common.schema.json#/$defs/contentReference"},
          "evidenceRefs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["selectionAuthority", "metricsCannotSelectOwner", "metricsCannotPassVisualGate", "fitCannotMutateProjectState", "selectedTrialRequiresActualVisualReview", "oneCheckpointCandidateAfterSelection", "trialContentReferencesMustVerify"],
      "properties": {
        "selectionAuthority": {"const": "candidate-ranking-only"}, "metricsCannotSelectOwner": {"const": true}, "metricsCannotPassVisualGate": {"const": true},
        "fitCannotMutateProjectState": {"const": true}, "selectedTrialRequiresActualVisualReview": {"const": true},
        "oneCheckpointCandidateAfterSelection": {"const": true}, "trialContentReferencesMustVerify": {"const": true}
      }
    },
    "reportDigest": {"$ref": "common.schema.json#/$defs/digest"}
  }
}
