{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/realized-contact-graph.schema.json",
  "title": "RefAs realized contact graph",
  "type": "object",
  "required": ["schema", "planDigest", "assetSha256", "nodes", "edges", "fusionChecks", "broadPhase", "metrics", "evidenceRefs", "graphDigest"],
  "properties": {
    "schema": {"const": "refas.realized-contact-graph/v1"},
    "planDigest": {"$ref": "common.schema.json#/$defs/sha256"},
    "assetSha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "nodes": {"type": "array", "items": {"type": "object"}},
    "edges": {"type": "array", "items": {"type": "object"}},
    "fusionChecks": {"type": "array", "items": {"type": "object"}},
    "broadPhase": {"type": "object", "required": ["margin", "candidatePairs", "totalPossiblePairs", "authority"]},
    "metrics": {"type": "object", "required": ["physicalNodes", "contactEdges", "clearanceEdges", "penetrationEdges"]},
    "evidenceRefs": {"type": "array", "items": {"type": "string"}},
    "graphDigest": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "additionalProperties": false
}
