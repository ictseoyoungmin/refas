{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/assembly-contract.schema.json",
  "title": "RefAs assembly contract",
  "type": "object",
  "required": ["schema", "scopeId", "sourceSha256", "parts", "relations", "supportZones", "supportHypotheses", "closedChildren", "attestation", "ambiguities", "policy", "contractDigest"],
  "properties": {
    "schema": {"const": "refas.assembly-contract/v1"},
    "scopeId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "sourceSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scopeId", "observedPolygon", "rootAnchor", "depthBand", "evidenceRefs"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/semanticId"},
          "scopeId": {"$ref": "common.schema.json#/$defs/semanticId"},
          "observedPolygon": {"type": "array", "minItems": 3, "items": {"$ref": "common.schema.json#/$defs/point2"}},
          "rootAnchor": {"$ref": "common.schema.json#/$defs/point2"},
          "depthBand": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false},
          "evidenceRefs": {"$ref": "common.schema.json#/$defs/evidenceRefs"}
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "subjectId", "objectId", "evidenceRefs"],
        "properties": {
          "kind": {"enum": ["in-front-of", "overlaps", "adjacent-to", "attached-to", "root-covered-by"]},
          "subjectId": {"$ref": "common.schema.json#/$defs/semanticId"},
          "objectId": {"$ref": "common.schema.json#/$defs/semanticId"},
          "evidenceRefs": {"$ref": "common.schema.json#/$defs/evidenceRefs"}
        },
        "additionalProperties": false
      }
    },
    "supportZones": {"type": "array"},
    "supportHypotheses": {"type": "array"},
    "closedChildren": {"type": "array"},
    "attestation": {"type": "object", "required": ["evidenceRefs", "digest"]},
    "ambiguities": {"type": "array", "items": {"type": "string"}},
    "policy": {"type": "object"},
    "contractDigest": {"$ref": "common.schema.json#/$defs/digest"}
  },
  "additionalProperties": false
}
