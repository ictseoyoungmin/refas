{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://refas.dev/schemas/bilateral-pair-realization.schema.json",
  "title":"RefAs bilateral pair candidate realization",
  "type":"object",
  "required":[
    "schema","scopeId","sourceSha256","candidateSha256","relationalStructureDigest",
    "relationId","relationDigest","sagittalPlaneId","restGeometryPolicy","lateralSpan",
    "intrinsicAsymmetry","cameraExplanation","instances","evidenceRefs","policy","realizationDigest"
  ],
  "properties":{
    "schema":{"const":"refas.bilateral-pair-realization/v1"},
    "scopeId":{"$ref":"common.schema.json#/$defs/semanticId"},
    "sourceSha256":{"$ref":"common.schema.json#/$defs/digest"},
    "candidateSha256":{"$ref":"common.schema.json#/$defs/digest"},
    "relationalStructureDigest":{"$ref":"common.schema.json#/$defs/digest"},
    "relationId":{"$ref":"common.schema.json#/$defs/semanticId"},
    "relationDigest":{"$ref":"common.schema.json#/$defs/digest"},
    "sagittalPlaneId":{"$ref":"common.schema.json#/$defs/semanticId"},
    "restGeometryPolicy":{"enum":["shared-mirrored","observed-intrinsic-asymmetry"]},
    "lateralSpan":{
      "type":"object",
      "required":["halfSpan","authority","basisKind","evidenceRefs"],
      "properties":{
        "halfSpan":{"type":"number","exclusiveMinimum":0},
        "authority":{"enum":["observed","inferred","engineered"]},
        "basisKind":{"enum":["body-relative-inference","structural-prior","external-spec","source-depth-evidence","engineered-layout"]},
        "evidenceRefs":{"$ref":"common.schema.json#/$defs/evidenceRefs"}
      },
      "additionalProperties":false
    },
    "intrinsicAsymmetry":{
      "oneOf":[
        {"type":"null"},
        {
          "type":"object",
          "required":["authority","sourceObservation","evidenceRefs"],
          "properties":{
            "authority":{"const":"observed"},
            "sourceObservation":{"type":"string","minLength":1},
            "evidenceRefs":{"$ref":"common.schema.json#/$defs/evidenceRefs"}
          },
          "additionalProperties":false
        }
      ]
    },
    "cameraExplanation":{
      "type":"object",
      "required":["hypothesisDigest","evidenceRefs"],
      "properties":{
        "hypothesisDigest":{"oneOf":[{"type":"null"},{"$ref":"common.schema.json#/$defs/digest"}]},
        "evidenceRefs":{"$ref":"common.schema.json#/$defs/evidenceRefs"}
      },
      "additionalProperties":false
    },
    "instances":{
      "type":"array",
      "minItems":2,
      "maxItems":2,
      "items":{
        "type":"object",
        "required":[
          "entityId","side","restGeometryDigest","constructionExecutionDigest",
          "constructionPermitDigest","transformDigest","transformParity","poseExplanation"
        ],
        "properties":{
          "entityId":{"$ref":"common.schema.json#/$defs/semanticId"},
          "side":{"enum":["left","right"]},
          "restGeometryDigest":{"$ref":"common.schema.json#/$defs/digest"},
          "constructionExecutionDigest":{"oneOf":[{"type":"null"},{"$ref":"common.schema.json#/$defs/digest"}]},
          "constructionPermitDigest":{"oneOf":[{"type":"null"},{"$ref":"common.schema.json#/$defs/digest"}]},
          "transformDigest":{"$ref":"common.schema.json#/$defs/digest"},
          "transformParity":{"enum":[-1,1]},
          "poseExplanation":{
            "type":"object",
            "required":["entityId","explanation","evidenceRefs"],
            "properties":{
              "entityId":{"$ref":"common.schema.json#/$defs/semanticId"},
              "explanation":{"type":"string","minLength":1},
              "evidenceRefs":{"$ref":"common.schema.json#/$defs/evidenceRefs"}
            },
            "additionalProperties":false
          }
        },
        "additionalProperties":false
      }
    },
    "evidenceRefs":{"$ref":"common.schema.json#/$defs/evidenceRefs"},
    "policy":{
      "type":"object",
      "required":[
        "pairRestGeometryComesFromCandidateBytes","sharedPairUsesOneRestGeometry",
        "sharedPairRequiresMirrorParity","visibleAsymmetryRequiresCameraAndPoseExplanation",
        "intrinsicAsymmetryRequiresObservedSourceEvidence","imagePlaneSeparationCannotAuthorizeLateralSpan"
      ],
      "properties":{
        "pairRestGeometryComesFromCandidateBytes":{"const":true},
        "sharedPairUsesOneRestGeometry":{"const":true},
        "sharedPairRequiresMirrorParity":{"const":true},
        "visibleAsymmetryRequiresCameraAndPoseExplanation":{"const":true},
        "intrinsicAsymmetryRequiresObservedSourceEvidence":{"const":true},
        "imagePlaneSeparationCannotAuthorizeLateralSpan":{"const":true}
      },
      "additionalProperties":false
    },
    "realizationDigest":{"$ref":"common.schema.json#/$defs/digest"}
  },
  "additionalProperties":false
}
