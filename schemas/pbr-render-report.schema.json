{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/pbr-render-report.schema.json",
  "title": "RefAs independent PBR renderer evidence",
  "type": "object",
  "required": ["schema", "claimScope", "assetSha256", "frameDigest", "renderer", "lighting", "colorPipeline", "materialSupport", "outputs", "reproducibility", "reportDigest"],
  "properties": {
    "schema": {"const": "refas.pbr-render-report/v1"},
    "claimScope": {"const": "visual-fidelity"},
    "assetSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "frameDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "renderer": {
      "type": "object",
      "required": ["family", "name", "version", "backend", "independentProcess"],
      "properties": {
        "family": {"enum": ["blender-cycles", "blender-eevee", "threejs-webgl", "filament", "gltf-sample-viewer", "vtk", "other"]},
        "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "backend": {"type": "string", "minLength": 1},
        "independentProcess": {"const": true}
      }, "additionalProperties": false
    },
    "lighting": {"type": "object", "required": ["rigId", "digest"], "properties": {"rigId": {"$ref": "common.schema.json#/$defs/semanticId"}, "digest": {"$ref": "common.schema.json#/$defs/digest"}}, "additionalProperties": false},
    "colorPipeline": {"type": "object", "required": ["exposure", "toneMapping", "outputColorSpace"], "properties": {"exposure": {"type": "number"}, "toneMapping": {"type": "string", "minLength": 1}, "outputColorSpace": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "materialSupport": {"type": "object", "required": ["supported", "unsupported"], "properties": {"supported": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}}, "unsupported": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}}}, "additionalProperties": false},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["viewId", "path", "sha256"], "properties": {"viewId": {"$ref": "common.schema.json#/$defs/semanticId"}, "path": {"$ref": "common.schema.json#/$defs/relativePath"}, "sha256": {"$ref": "common.schema.json#/$defs/digest"}}, "additionalProperties": false}},
    "reproducibility": {"type": "object", "required": ["mode", "tolerance"], "properties": {"mode": {"enum": ["deterministic", "bounded-nondeterminism"]}, "tolerance": {"type": "string"}}, "additionalProperties": false},
    "reportDigest": {"$ref": "common.schema.json#/$defs/digest"}
  }, "additionalProperties": false
}
