{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/whole-object-certificate.schema.json",
  "title": "RefAs whole-object certificate",
  "type": "object",
  "required": ["schema", "version", "projectId", "sourceSha256", "checkpointId", "checkpointDigest", "gateIds", "visualReview", "registeredComparison", "audit", "certificateDigest", "certifiedAt"],
  "properties": {
    "schema": {"const": "refas.whole-object-certificate/v1"},
    "version": {"const": "1.0.0"},
    "projectId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "sourceSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "checkpointId": {"type": "string", "pattern": "^cp_[a-f0-9]{20}$"},
    "checkpointDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "gateIds": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
    "visualReview": {
      "type": "object",
      "required": ["path", "sha256", "reviewDigest", "evidenceClass"],
      "properties": {
        "path": {"$ref": "common.schema.json#/$defs/relativePath"},
        "sha256": {"$ref": "common.schema.json#/$defs/digest"},
        "reviewDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "evidenceClass": {"const": "independent-reference"}
      },
      "additionalProperties": false
    },
    "registeredComparison": {
      "type": "object",
      "required": ["path", "sha256", "comparisonDigest", "sourceSha256", "sourceManifestSha256", "assetSha256", "renderReportPath", "renderReportSha256", "framePath", "frameSha256", "registrationDigest", "hierarchyDigest", "inputDigest", "scopeIds"],
      "properties": {
        "path": {"$ref": "common.schema.json#/$defs/relativePath"},
        "sha256": {"$ref": "common.schema.json#/$defs/digest"},
        "comparisonDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "sourceSha256": {"$ref": "common.schema.json#/$defs/digest"},
        "sourceManifestSha256": {"$ref": "common.schema.json#/$defs/digest"},
        "assetSha256": {"$ref": "common.schema.json#/$defs/digest"},
        "renderReportPath": {"$ref": "common.schema.json#/$defs/relativePath"},
        "renderReportSha256": {"$ref": "common.schema.json#/$defs/digest"},
        "framePath": {"$ref": "common.schema.json#/$defs/relativePath"},
        "frameSha256": {"$ref": "common.schema.json#/$defs/digest"},
        "registrationDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "hierarchyDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "inputDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "scopeIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}}
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": ["checkpointCount", "objectCount"],
      "properties": {"checkpointCount": {"type": "integer", "minimum": 1}, "objectCount": {"type": "integer", "minimum": 0}},
      "additionalProperties": false
    },
    "certificateDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "certifiedAt": {"type": "string", "format": "date-time"},
    "claimCertification": {
      "type": "object",
      "required": ["transaction", "policy", "decision"],
      "properties": {
        "transaction": {
          "type": "object",
          "required": ["id", "transactionDigest", "source"],
          "properties": {
            "id": {"type": "string", "pattern": "^ctx_[a-f0-9]{20}$"},
            "transactionDigest": {"$ref": "common.schema.json#/$defs/digest"},
            "source": {"enum": ["checkpoint-artifact", "runtime-synthesized"]}
          },
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "required": ["id", "policyDigest", "source"],
          "properties": {
            "id": {"$ref": "common.schema.json#/$defs/semanticId"},
            "policyDigest": {"$ref": "common.schema.json#/$defs/digest"},
            "source": {"enum": ["checkpoint-artifact", "runtime-default"]}
          },
          "additionalProperties": false
        },
        "decision": {
          "type": "object",
          "required": ["decisionDigest", "source", "authorizedClaimIds", "refusedClaimIds"],
          "properties": {
            "decisionDigest": {"$ref": "common.schema.json#/$defs/digest"},
            "source": {"enum": ["checkpoint-artifact", "runtime-evaluated"]},
            "authorizedClaimIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
            "refusedClaimIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "claimCertificationDigest": {"$ref": "common.schema.json#/$defs/digest"}
  },
  "additionalProperties": false
}
