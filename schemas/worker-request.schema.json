{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/worker-request.schema.json",
  "title": "RefAs external worker request",
  "type": "object",
  "required": [
    "schema",
    "workerRunId",
    "workerId",
    "sessionId",
    "projectId",
    "operationId",
    "operationRequestDigest",
    "intent",
    "inputDigest",
    "inputs",
    "timeoutMs",
    "requestDigest"
  ],
  "properties": {
    "schema": {"const": "refas.worker-request/v1"},
    "workerRunId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"},
    "workerId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"},
    "sessionId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"},
    "operationId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"},
    "operationRequestDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "intent": {"type": "string", "minLength": 1, "maxLength": 1000},
    "inputDigest": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]},
    "inputs": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/contentReference"}},
    "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 86400000},
    "requestDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "contentReference": {
      "type": "object",
      "required": ["schema", "kind", "path", "sha256", "sizeBytes"],
      "properties": {
        "schema": {"const": "refas.content-reference/v1"},
        "kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sizeBytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
