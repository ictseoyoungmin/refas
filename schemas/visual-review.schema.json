{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/visual-review.schema.json",
  "title": "RefAs digest-bound visual review",
  "type": "object",
  "required": ["schema", "scopeId", "sourceSha256", "assetSha256", "evidenceClass", "verdict", "views", "gateVerdicts", "unresolvedFindings", "renderer", "requiredMaterialFeatures", "attestation", "registeredComparison", "comparisonAssessment", "policy", "reviewDigest"],
  "properties": {
    "schema": {"const": "refas.visual-review/v1"},
    "scopeId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "sourceSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "assetSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "evidenceClass": {"enum": ["independent-reference", "self-generated-contract-fixture"]},
    "verdict": {"enum": ["pass", "fail", "insufficient"]},
    "views": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/verdict"}
    },
    "gateVerdicts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/verdict"}
    },
    "unresolvedFindings": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "renderer": {
      "type": "object",
      "required": ["kind", "family", "reportRef", "reportSha256", "independentProcess", "claimScope", "supportedMaterialFeatures", "unsupportedMaterialFeatures"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "family": {"enum": ["blender-cycles", "blender-eevee", "threejs-webgl", "filament", "gltf-sample-viewer", "vtk", "other"]},
        "reportRef": {"$ref": "common.schema.json#/$defs/relativePath"},
        "reportSha256": {"$ref": "common.schema.json#/$defs/digest"},
        "independentProcess": {"type": "boolean"},
        "claimScope": {"enum": ["render-integrity-only", "visual-fidelity"]},
        "supportedMaterialFeatures": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
        "unsupportedMaterialFeatures": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}}
      },
      "additionalProperties": false
    },
    "requiredMaterialFeatures": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
    "registeredComparison": {
      "type": ["object", "null"],
      "required": ["path", "sha256", "comparisonDigest", "sourceSha256", "sourceManifestSha256", "assetSha256", "renderReportPath", "renderReportSha256", "framePath", "frameSha256", "registrationDigest", "hierarchyDigest", "inputDigest", "scopeIds"],
      "properties": {
        "path": {"$ref": "common.schema.json#/$defs/relativePath"},
        "sha256": {"$ref": "common.schema.json#/$defs/digest"},
        "comparisonDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "sourceSha256": {"$ref": "common.schema.json#/$defs/digest"},
        "sourceManifestSha256": {"$ref": "common.schema.json#/$defs/digest"},
        "assetSha256": {"$ref": "common.schema.json#/$defs/digest"},
        "renderReportPath": {"$ref": "common.schema.json#/$defs/relativePath"},
        "renderReportSha256": {"$ref": "common.schema.json#/$defs/digest"},
        "framePath": {"$ref": "common.schema.json#/$defs/relativePath"},
        "frameSha256": {"$ref": "common.schema.json#/$defs/digest"},
        "registrationDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "hierarchyDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "inputDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "scopeIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}}
      },
      "additionalProperties": false
    },
    "comparisonAssessment": {
      "type": ["object", "null"],
      "required": ["sourceObservation", "renderObservation", "comparisonConclusion", "evidenceRefs", "contradictionResolution"],
      "properties": {
        "sourceObservation": {"type": "string", "minLength": 1},
        "renderObservation": {"type": "string", "minLength": 1},
        "comparisonConclusion": {"type": "string", "minLength": 1},
        "evidenceRefs": {"$ref": "common.schema.json#/$defs/evidenceRefs"},
        "contradictionResolution": {
          "type": "object",
          "required": ["status", "explanation", "evidenceRefs", "findingRefs"],
          "properties": {
            "status": {"enum": ["not-present", "resolved", "unresolved"]},
            "explanation": {"type": "string"},
            "evidenceRefs": {"type": "array", "items": {"type": "string"}},
            "findingRefs": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "attestation": {
      "type": "object",
      "required": ["evidenceRefs", "digest"],
      "properties": {
        "evidenceRefs": {"$ref": "common.schema.json#/$defs/evidenceRefs"},
        "digest": {"$ref": "common.schema.json#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["selfGeneratedFixturesAreContractOnly", "renderIntegrityIsNotVisualAcceptance", "unsupportedMaterialFeaturesCannotPassAppearance", "independentPbrRendererRequiredAfterPortableGate", "unresolvedBlockingFindingsPreventClosure", "substantiveObservationsRequiredForPass", "independentPassRequiresRegisteredComparison", "contradictionEvidenceRequiresResolution"],
      "properties": {
        "selfGeneratedFixturesAreContractOnly": {"const": true},
        "renderIntegrityIsNotVisualAcceptance": {"const": true},
        "unsupportedMaterialFeaturesCannotPassAppearance": {"const": true},
        "independentPbrRendererRequiredAfterPortableGate": {"const": true},
        "unresolvedBlockingFindingsPreventClosure": {"const": true},
        "substantiveObservationsRequiredForPass": {"const": true},
        "independentPassRequiresRegisteredComparison": {"const": true},
        "contradictionEvidenceRequiresResolution": {"const": true}
      },
      "additionalProperties": false
    },
    "reviewDigest": {"$ref": "common.schema.json#/$defs/digest"}
  },
  "$defs": {
    "verdict": {
      "type": "object",
      "required": ["id", "status", "evidenceRefs", "summary"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/semanticId"},
        "status": {"enum": ["pass", "fail", "insufficient"]},
        "evidenceRefs": {"$ref": "common.schema.json#/$defs/evidenceRefs"},
        "summary": {"type": "string"},
        "observation": {
          "type": "object",
          "required": ["sourceObservation", "renderObservation", "comparisonConclusion", "evidenceRefs"],
          "properties": {
            "sourceObservation": {"type": "string", "minLength": 1},
            "renderObservation": {"type": "string", "minLength": 1},
            "comparisonConclusion": {"type": "string", "minLength": 1},
            "evidenceRefs": {"$ref": "common.schema.json#/$defs/evidenceRefs"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
