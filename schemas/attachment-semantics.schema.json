{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/attachment-semantics.schema.json",
  "title": "RefAs attachment semantics",
  "type": "object",
  "required": ["schema", "scopeId", "sourceSha256", "entities", "relations", "evidenceRefs", "policy", "semanticsDigest"],
  "properties": {
    "schema": {"const": "refas.attachment-semantics/v1"},
    "scopeId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "sourceSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scopeId", "evidenceRefs"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/semanticId"},
          "scopeId": {"$ref": "common.schema.json#/$defs/semanticId"},
          "evidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "mode", "subjectId", "ownerIds", "basis", "evidenceRefs", "semantics"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/semanticId"},
          "mode": {"enum": ["FUSED", "RIGID_FOLLOW", "SURFACE_OFFSET", "MULTI_ANCHOR", "ARTICULATED", "SUPPORTED_CLEARANCE", "FREE"]},
          "subjectId": {"$ref": "common.schema.json#/$defs/semanticId"},
          "ownerIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
          "basis": {"enum": ["observed", "interpreted", "construction"]},
          "evidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "semantics": {
            "type": "object",
            "required": ["propagatesOwnerChange", "requiresSolver"],
            "properties": {
              "propagatesOwnerChange": {"type": "boolean"},
              "requiresSolver": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "policy": {
      "type": "object",
      "required": ["implicitAttachmentForbidden", "everyEntityRequiresExplicitMode", "ownerDependentRolesAreExplicit", "ownershipCyclesForbidden", "modeSpecificOwnerArityRequired", "semanticsDoNotMutateGeometry", "semanticsDoNotAuthorizeClosure"],
      "properties": {
        "implicitAttachmentForbidden": {"const": true},
        "everyEntityRequiresExplicitMode": {"const": true},
        "ownerDependentRolesAreExplicit": {"const": true},
        "ownershipCyclesForbidden": {"const": true},
        "modeSpecificOwnerArityRequired": {"const": true},
        "semanticsDoNotMutateGeometry": {"const": true},
        "semanticsDoNotAuthorizeClosure": {"const": true}
      },
      "additionalProperties": false
    },
    "semanticsDigest": {"$ref": "common.schema.json#/$defs/digest"}
  },
  "additionalProperties": false
}
