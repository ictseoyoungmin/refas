{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://refas.dev/schemas/structural-plausibility.schema.json",
  "title":"RefAs candidate-bound root and static-support plausibility",
  "type":"object",
  "required":[
    "schema","scopeId","sourceSha256","candidateSha256","attachmentSemanticsDigest",
    "status","rootChecks","groundSupport","findings","evidenceRefs","policy","plausibilityDigest"
  ],
  "properties":{
    "schema":{"const":"refas.structural-plausibility/v1"},
    "scopeId":{"$ref":"common.schema.json#/$defs/semanticId"},
    "sourceSha256":{"$ref":"common.schema.json#/$defs/digest"},
    "candidateSha256":{"$ref":"common.schema.json#/$defs/digest"},
    "attachmentSemanticsDigest":{"$ref":"common.schema.json#/$defs/digest"},
    "status":{"enum":["PASS","BLOCKED","NOT_APPLICABLE"]},
    "rootChecks":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["relationId","subjectId","ownerId","rootWorldPoint","insideOwnerVolume","minimumSurfaceDistance","tolerance","status","evidenceRefs"],
        "properties":{
          "relationId":{"$ref":"common.schema.json#/$defs/semanticId"},
          "subjectId":{"$ref":"common.schema.json#/$defs/semanticId"},
          "ownerId":{"$ref":"common.schema.json#/$defs/semanticId"},
          "rootWorldPoint":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},
          "insideOwnerVolume":{"type":"boolean"},
          "minimumSurfaceDistance":{"type":"number","minimum":0},
          "tolerance":{"type":"number","minimum":0},
          "status":{"enum":["PASS","BLOCKED"]},
          "evidenceRefs":{"$ref":"common.schema.json#/$defs/evidenceRefs"}
        },
        "additionalProperties":false
      }
    },
    "groundSupport":{
      "oneOf":[
        {"type":"null"},
        {
          "type":"object",
          "required":["mode","status","groundAxis","sourceObservation","evidenceRefs"],
          "properties":{
            "mode":{"const":"source-supported-exempt"},
            "status":{"const":"NOT_APPLICABLE"},
            "groundAxis":{"enum":["x","y","z"]},
            "sourceObservation":{"type":"string","minLength":1},
            "evidenceRefs":{"$ref":"common.schema.json#/$defs/evidenceRefs"}
          },
          "additionalProperties":false
        },
        {
          "type":"object",
          "required":[
            "mode","status","groundAxis","groundCoordinate","centerOfMass","projectedCenterOfMass",
            "supportPolygon","insideSupportPolygon","margin","minimumMargin","contactEntityIds","evidenceRefs"
          ],
          "properties":{
            "mode":{"const":"grounded"},
            "status":{"enum":["PASS","BLOCKED"]},
            "groundAxis":{"enum":["x","y","z"]},
            "groundCoordinate":{"type":"number"},
            "centerOfMass":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},
            "projectedCenterOfMass":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}},
            "supportPolygon":{"type":"array","minItems":3,"items":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}}},
            "insideSupportPolygon":{"type":"boolean"},
            "margin":{"type":"number","minimum":0},
            "minimumMargin":{"type":"number","minimum":0},
            "contactEntityIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"common.schema.json#/$defs/semanticId"}},
            "evidenceRefs":{"$ref":"common.schema.json#/$defs/evidenceRefs"}
          },
          "additionalProperties":false
        }
      ]
    },
    "findings":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["type","owner","subjectId","message","evidenceRefs"],
        "properties":{
          "type":{"enum":["attachment-mismatch","whole-system-relation-mismatch"]},
          "owner":{"enum":["assembly","shape-reconstruction"]},
          "subjectId":{"$ref":"common.schema.json#/$defs/semanticId"},
          "message":{"type":"string","minLength":1},
          "evidenceRefs":{"$ref":"common.schema.json#/$defs/evidenceRefs"}
        },
        "additionalProperties":false
      }
    },
    "evidenceRefs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "policy":{
      "type":"object",
      "required":[
        "exactCandidateBytesAreAuthority","contactAloneCannotAuthorizeEmbeddedRoot",
        "rootUsesParentRealizedTriangleVolume","supportUsesRealizedVolumeWeightedCenterOfMass",
        "supportPolygonUsesDeclaredGroundContacts","sourceSupportedExemptionRemainsExplicit",
        "noAggregatePlausibilityScore"
      ],
      "properties":{
        "exactCandidateBytesAreAuthority":{"const":true},
        "contactAloneCannotAuthorizeEmbeddedRoot":{"const":true},
        "rootUsesParentRealizedTriangleVolume":{"const":true},
        "supportUsesRealizedVolumeWeightedCenterOfMass":{"const":true},
        "supportPolygonUsesDeclaredGroundContacts":{"const":true},
        "sourceSupportedExemptionRemainsExplicit":{"const":true},
        "noAggregatePlausibilityScore":{"const":true}
      },
      "additionalProperties":false
    },
    "plausibilityDigest":{"$ref":"common.schema.json#/$defs/digest"}
  },
  "additionalProperties":false
}
