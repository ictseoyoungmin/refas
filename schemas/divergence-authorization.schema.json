{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/divergence-authorization.schema.json",
  "title": "RefAs divergence authorization",
  "type": "object",
  "required": ["schema","authorizationId","scopeId","validationBinding","authorityBinding","declarations","resolutions","summary","policy","authorizationDigest"],
  "properties": {
    "schema": {"const":"refas.divergence-authorization/v1"},
    "authorizationId": {"$ref":"common.schema.json#/$defs/semanticId"},
    "scopeId": {"$ref":"common.schema.json#/$defs/semanticId"},
    "validationBinding": {"$ref":"#/$defs/validationBinding"},
    "authorityBinding": {"$ref":"#/$defs/authorityBinding"},
    "declarations": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/declaration"}},
    "resolutions": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/resolution"}},
    "summary": {"$ref":"#/$defs/summary"},
    "policy": {"$ref":"#/$defs/policy"},
    "authorizationDigest": {"$ref":"common.schema.json#/$defs/digest"}
  },
  "$defs": {
    "validationBinding": {"type":"object","required":["validationId","validationDigest","canonicalViewDigest","capacityDigest","normalizationDigest","backend"],"properties":{"validationId":{"$ref":"common.schema.json#/$defs/semanticId"},"validationDigest":{"$ref":"common.schema.json#/$defs/digest"},"canonicalViewDigest":{"$ref":"common.schema.json#/$defs/digest"},"capacityDigest":{"$ref":"common.schema.json#/$defs/digest"},"normalizationDigest":{"$ref":"common.schema.json#/$defs/digest"},"backend":{"type":"string","minLength":1,"maxLength":256}},"additionalProperties":false},
    "authorityBinding": {"type":"object","required":["schema","authoritySetDigest","targetSchema","targetDigest","sourceSha256"],"properties":{"schema":{"const":"refas.divergence-authority-binding/v1"},"authoritySetDigest":{"$ref":"common.schema.json#/$defs/digest"},"targetSchema":{"const":"refas.cross-representation-validation/v1"},"targetDigest":{"$ref":"common.schema.json#/$defs/digest"},"sourceSha256":{"$ref":"common.schema.json#/$defs/digest"}},"additionalProperties":false},
    "declaration": {"type":"object","required":["declarationId","findingId","obligationId","targetBackend","semanticPath","subjectIds","fieldPath","canonicalValue","overrideValue","authoritySubjectId","reason"],"properties":{"declarationId":{"$ref":"common.schema.json#/$defs/semanticId"},"findingId":{"$ref":"common.schema.json#/$defs/semanticId"},"obligationId":{"$ref":"common.schema.json#/$defs/semanticId"},"targetBackend":{"type":"string","minLength":1,"maxLength":256},"semanticPath":{"type":"string","minLength":1,"maxLength":160},"subjectIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"common.schema.json#/$defs/semanticId"}},"fieldPath":{"type":"string","maxLength":512,"pattern":"^(|/.*)$"},"canonicalValue":{},"overrideValue":{},"authoritySubjectId":{"$ref":"common.schema.json#/$defs/semanticId"},"reason":{"type":"string","minLength":1}},"additionalProperties":false},
    "resolution": {"type":"object","required":["findingId","obligationId","sourceOutcome","outcome","declarationIds"],"properties":{"findingId":{"$ref":"common.schema.json#/$defs/semanticId"},"obligationId":{"$ref":"common.schema.json#/$defs/semanticId"},"sourceOutcome":{"enum":["EQUIVALENT","LOSSY","DRIFT","UNRESOLVED","INVALID"]},"outcome":{"enum":["EQUIVALENT","LOSSY","DRIFT","DECLARED_DIVERGENCE","UNRESOLVED","INVALID"]},"declarationIds":{"type":"array","uniqueItems":true,"items":{"$ref":"common.schema.json#/$defs/semanticId"}}},"additionalProperties":false},
    "summary": {"type":"object","required":["total","equivalent","lossy","drift","declaredDivergence","unresolved","invalid"],"properties":{"total":{"type":"integer","minimum":1},"equivalent":{"type":"integer","minimum":0},"lossy":{"type":"integer","minimum":0},"drift":{"type":"integer","minimum":0},"declaredDivergence":{"type":"integer","minimum":0},"unresolved":{"type":"integer","minimum":0},"invalid":{"type":"integer","minimum":0}},"additionalProperties":false},
    "policy": {"type":"object","required":["canonicalStateRemainsAuthoritative","p14FindingsRemainImmutableEvidence","onlyDriftMayBeDeclared","declarationsAreBackendSpecific","declarationsAreFieldScoped","partialCoverageCannotMaskDrift","overlappingFieldPathsForbidden","semanticAuthorityIsReused","engineeredAuthorityRequired","authorityBindsExactP14Validation","declaredDivergenceDoesNotMutateCanonicalState","aggregateScoresCannotOverrideFindings","physicalClaimsRemainDownstream"],"properties":{"canonicalStateRemainsAuthoritative":{"const":true},"p14FindingsRemainImmutableEvidence":{"const":true},"onlyDriftMayBeDeclared":{"const":true},"declarationsAreBackendSpecific":{"const":true},"declarationsAreFieldScoped":{"const":true},"partialCoverageCannotMaskDrift":{"const":true},"overlappingFieldPathsForbidden":{"const":true},"semanticAuthorityIsReused":{"const":true},"engineeredAuthorityRequired":{"const":true},"authorityBindsExactP14Validation":{"const":true},"declaredDivergenceDoesNotMutateCanonicalState":{"const":true},"aggregateScoresCannotOverrideFindings":{"const":true},"physicalClaimsRemainDownstream":{"const":true}},"additionalProperties":false}
  },
  "additionalProperties": false
}
