{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/rigid-body-dynamics.schema.json",
  "title": "RefAs rigid-body dynamics",
  "type": "object",
  "required": [
    "schema",
    "scopeId",
    "sourceSha256",
    "identityGraphRef",
    "links",
    "policy",
    "dynamicsDigest"
  ],
  "properties": {
    "schema": {"const": "refas.rigid-body-dynamics/v1"},
    "scopeId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "sourceSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "identityGraphRef": {
      "type": "object",
      "required": ["schema", "digest"],
      "properties": {
        "schema": {"const": "refas.physical-identity-graph/v1"},
        "digest": {"$ref": "common.schema.json#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/linkDynamics"}
    },
    "policy": {
      "type": "object",
      "required": [
        "rigidLinkIdentityRequired",
        "exactIdentityGraphBinding",
        "referenceFrameIsBoundLink",
        "centerOfMassUsesMeters",
        "inertiaAboutCenterOfMass",
        "inertiaUsesKgM2",
        "unresolvedValuesRemainNull",
        "semanticAuthorityRemainsExternal",
        "fabricatedDefaultsForbidden",
        "dynamicsDoNotAssertSourceTruth"
      ],
      "properties": {
        "rigidLinkIdentityRequired": {"const": true},
        "exactIdentityGraphBinding": {"const": true},
        "referenceFrameIsBoundLink": {"const": true},
        "centerOfMassUsesMeters": {"const": true},
        "inertiaAboutCenterOfMass": {"const": true},
        "inertiaUsesKgM2": {"const": true},
        "unresolvedValuesRemainNull": {"const": true},
        "semanticAuthorityRemainsExternal": {"const": true},
        "fabricatedDefaultsForbidden": {"const": true},
        "dynamicsDoNotAssertSourceTruth": {"const": true}
      },
      "additionalProperties": false
    },
    "dynamicsDigest": {"$ref": "common.schema.json#/$defs/digest"}
  },
  "$defs": {
    "authoritySubjectId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "mass": {
      "type": "object",
      "required": ["value_kg", "authoritySubjectId"],
      "properties": {
        "value_kg": {
          "anyOf": [
            {"type": "null"},
            {"type": "number", "exclusiveMinimum": 0}
          ]
        },
        "authoritySubjectId": {"$ref": "#/$defs/authoritySubjectId"}
      },
      "additionalProperties": false
    },
    "centerOfMass": {
      "type": "object",
      "required": ["value_m", "authoritySubjectId"],
      "properties": {
        "value_m": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "array",
              "prefixItems": [
                {"type": "number"},
                {"type": "number"},
                {"type": "number"}
              ],
              "items": false
            }
          ]
        },
        "authoritySubjectId": {"$ref": "#/$defs/authoritySubjectId"}
      },
      "additionalProperties": false
    },
    "tensorRow": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false
    },
    "inertia": {
      "type": "object",
      "required": ["tensor_kg_m2", "authoritySubjectId"],
      "properties": {
        "tensor_kg_m2": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "array",
              "prefixItems": [
                {"$ref": "#/$defs/tensorRow"},
                {"$ref": "#/$defs/tensorRow"},
                {"$ref": "#/$defs/tensorRow"}
              ],
              "items": false
            }
          ]
        },
        "authoritySubjectId": {"$ref": "#/$defs/authoritySubjectId"}
      },
      "additionalProperties": false
    },
    "linkDynamics": {
      "type": "object",
      "required": [
        "linkId",
        "referenceFrameId",
        "mass",
        "centerOfMass",
        "inertia"
      ],
      "properties": {
        "linkId": {"$ref": "common.schema.json#/$defs/semanticId"},
        "referenceFrameId": {"$ref": "common.schema.json#/$defs/semanticId"},
        "mass": {"$ref": "#/$defs/mass"},
        "centerOfMass": {"$ref": "#/$defs/centerOfMass"},
        "inertia": {"$ref": "#/$defs/inertia"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
