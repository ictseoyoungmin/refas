{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/registered-comparison.schema.json",
  "title": "RefAs Registered Comparison",
  "type": "object",
  "required": ["schema", "claimScope", "source", "render", "registration", "hierarchy", "scopes", "policy", "inputDigest", "comparisonDigest"],
  "properties": {
    "schema": {"const": "refas.registered-comparison/v1"},
    "claimScope": {"const": "critique-evidence-only"},
    "source": {"type": "object", "required": ["sha256", "manifestSha256"]},
    "render": {"type": "object", "required": ["assetSha256", "frameId", "frameSha256", "reportSha256"]},
    "registration": {"type": "object", "required": ["digest", "fileSha256", "model", "metrics"]},
    "hierarchy": {"type": "object", "required": ["digest", "fileSha256"]},
    "scopes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["scopeId", "level", "ancestry", "metrics", "images"]}},
    "policy": {"type": "object", "required": ["rawSourceRemainsPrimary", "outputsAreDerivedObservationAids", "metricsCannotSetVisualGate", "metricFailureRequiresTypedFindingBeforeRouting", "registrationResidualIsNotShapeTruth"]},
    "inputDigest": {"$ref": "common.schema.json#/$defs/sha256"},
    "comparisonDigest": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "additionalProperties": true
}
