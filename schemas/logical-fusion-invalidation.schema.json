{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/logical-fusion-invalidation.schema.json",
  "title": "RefAs logical fusion invalidation",
  "type": "object",
  "required": ["schema", "scopeId", "sourceSha256", "attachmentSemanticsDigest", "fusionDigest", "changedEntityIds", "invalidatedGroupIds", "invalidatedMemberIds", "unaffectedEntityIds", "requiresFusionRebuild", "requiresPreFusionSemanticState", "evidenceRefs", "policy", "invalidationDigest"],
  "properties": {
    "schema": {"const": "refas.logical-fusion-invalidation/v1"},
    "scopeId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "sourceSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "attachmentSemanticsDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "fusionDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "changedEntityIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
    "invalidatedGroupIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
    "invalidatedMemberIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
    "unaffectedEntityIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
    "requiresFusionRebuild": {"type": "boolean"},
    "requiresPreFusionSemanticState": {"type": "boolean"},
    "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "policy": {
      "type": "object",
      "required": ["invalidationDoesNotMoveGeometry", "invalidationCannotAuthorizeClosure", "nonFusedDependentsAreHandledByAttachmentPropagation", "physicalFusionArtifactCannotBeCanonicalReopenSource"],
      "properties": {
        "invalidationDoesNotMoveGeometry": {"const": true},
        "invalidationCannotAuthorizeClosure": {"const": true},
        "nonFusedDependentsAreHandledByAttachmentPropagation": {"const": true},
        "physicalFusionArtifactCannotBeCanonicalReopenSource": {"const": true}
      },
      "additionalProperties": false
    },
    "invalidationDigest": {"$ref": "common.schema.json#/$defs/digest"}
  },
  "additionalProperties": false
}
