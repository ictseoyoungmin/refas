{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/reference-geometry.schema.json",
  "title": "RefAs source-space reference geometry",
  "type": "object",
  "required": ["schema", "scopeId", "sourceSha256", "coordinateSpace", "anchors", "chains", "axes", "contacts", "occlusions", "negativeSpaces", "contours", "dimensions", "attestation", "policy", "geometryDigest"],
  "properties": {
    "schema": {"const": "refas.reference-geometry/v1"},
    "scopeId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "sourceSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "coordinateSpace": {"type": "object", "required": ["kind", "origin", "xRange", "yRange"], "properties": {"kind": {"const": "normalized-image"}, "origin": {"const": "top-left"}, "xRange": {"const": [0, 1]}, "yRange": {"const": [0, 1]}}, "additionalProperties": false},
    "anchors": {"type": "array", "items": {"$ref": "#/$defs/anchor"}},
    "chains": {"type": "array", "items": {"$ref": "#/$defs/chain"}},
    "axes": {"type": "array", "items": {"$ref": "#/$defs/axis"}},
    "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
    "interfaces": {"type": "array", "items": {"$ref": "#/$defs/interface"}},
    "contacts": {"type": "array", "items": {"$ref": "#/$defs/contact"}},
    "occlusions": {"type": "array", "items": {"$ref": "#/$defs/occlusion"}},
    "negativeSpaces": {"type": "array", "items": {"$ref": "#/$defs/negativeSpace"}},
    "contours": {"type": "array", "items": {"$ref": "#/$defs/contour"}},
    "dimensions": {"type": "array", "items": {"$ref": "#/$defs/dimension"}},
    "attestation": {"type": "object", "required": ["evidenceRefs", "digest"], "properties": {"evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}, "digest": {"$ref": "common.schema.json#/$defs/digest"}}, "additionalProperties": false},
    "policy": {"type": "object"},
    "geometryDigest": {"$ref": "common.schema.json#/$defs/digest"}
  },
  "$defs": {
    "point2": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}], "items": false},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "importance": {"enum": ["macro", "identity", "detail"]},
    "visibility": {"enum": ["visible", "partially-occluded", "occluded", "inferred"]},
    "separation": {"enum": ["explicit", "suggested", "uncertain"]},
    "anchor": {"type": "object", "required": ["id", "importance", "evidenceRefs", "xy", "visibility", "confidence", "semanticRole"], "properties": {"id": {"$ref": "common.schema.json#/$defs/semanticId"}, "importance": {"$ref": "#/$defs/importance"}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}, "xy": {"$ref": "#/$defs/point2"}, "visibility": {"$ref": "#/$defs/visibility"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "semanticRole": {"type": "string"}}, "additionalProperties": false},
    "chain": {"type": "object", "required": ["id", "importance", "evidenceRefs", "anchorIds", "closed"], "properties": {"id": {"$ref": "common.schema.json#/$defs/semanticId"}, "importance": {"$ref": "#/$defs/importance"}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}, "anchorIds": {"type": "array", "minItems": 2, "items": {"$ref": "common.schema.json#/$defs/semanticId"}}, "closed": {"type": "boolean"}}, "additionalProperties": false},
    "axis": {"type": "object", "required": ["id", "importance", "evidenceRefs", "fromAnchorId", "toAnchorId"], "properties": {"id": {"$ref": "common.schema.json#/$defs/semanticId"}, "importance": {"$ref": "#/$defs/importance"}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}, "fromAnchorId": {"$ref": "common.schema.json#/$defs/semanticId"}, "toAnchorId": {"$ref": "common.schema.json#/$defs/semanticId"}}, "additionalProperties": false},
    "segment": {"type": "object", "required": ["id", "importance", "evidenceRefs", "label", "polygon", "anchorIds", "visibility", "separation"], "properties": {"id": {"$ref": "common.schema.json#/$defs/semanticId"}, "importance": {"$ref": "#/$defs/importance"}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}, "label": {"type": "string"}, "polygon": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/point2"}}, "anchorIds": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/semanticId"}}, "visibility": {"$ref": "#/$defs/visibility"}, "separation": {"$ref": "#/$defs/separation"}}, "additionalProperties": false},
    "interface": {"type": "object", "required": ["id", "importance", "evidenceRefs", "subjectSegmentId", "objectSegmentId", "kind", "separation", "boundary", "visibility"], "properties": {"id": {"$ref": "common.schema.json#/$defs/semanticId"}, "importance": {"$ref": "#/$defs/importance"}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}, "subjectSegmentId": {"$ref": "common.schema.json#/$defs/semanticId"}, "objectSegmentId": {"$ref": "common.schema.json#/$defs/semanticId"}, "kind": {"enum": ["joint-gap", "joint-boundary", "seam", "overlap-boundary", "necked-transition", "contact-boundary", "unknown"]}, "separation": {"$ref": "#/$defs/separation"}, "boundary": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/point2"}}, "visibility": {"$ref": "#/$defs/visibility"}}, "additionalProperties": false},
    "contact": {"type": "object", "required": ["id", "importance", "evidenceRefs", "aAnchorId", "bAnchorId", "relation", "toleranceNormalized"], "properties": {"id": {"$ref": "common.schema.json#/$defs/semanticId"}, "importance": {"$ref": "#/$defs/importance"}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}, "aAnchorId": {"$ref": "common.schema.json#/$defs/semanticId"}, "bAnchorId": {"$ref": "common.schema.json#/$defs/semanticId"}, "relation": {"enum": ["touching", "near", "supported-by", "coincident"]}, "toleranceNormalized": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false},
    "occlusion": {"type": "object", "required": ["id", "importance", "evidenceRefs", "frontId", "backId"], "properties": {"id": {"$ref": "common.schema.json#/$defs/semanticId"}, "importance": {"$ref": "#/$defs/importance"}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}, "frontId": {"$ref": "common.schema.json#/$defs/semanticId"}, "backId": {"$ref": "common.schema.json#/$defs/semanticId"}}, "additionalProperties": false},
    "negativeSpace": {"type": "object", "required": ["id", "importance", "evidenceRefs", "polygon"], "properties": {"id": {"$ref": "common.schema.json#/$defs/semanticId"}, "importance": {"$ref": "#/$defs/importance"}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}, "polygon": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/point2"}}}, "additionalProperties": false},
    "contour": {"type": "object", "required": ["id", "importance", "evidenceRefs", "points", "closed"], "properties": {"id": {"$ref": "common.schema.json#/$defs/semanticId"}, "importance": {"$ref": "#/$defs/importance"}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}, "points": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/point2"}}, "closed": {"type": "boolean"}}, "additionalProperties": false},
    "dimension": {"type": "object", "required": ["id", "importance", "evidenceRefs", "aAnchorId", "bAnchorId", "kind"], "properties": {"id": {"$ref": "common.schema.json#/$defs/semanticId"}, "importance": {"$ref": "#/$defs/importance"}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}, "aAnchorId": {"$ref": "common.schema.json#/$defs/semanticId"}, "bAnchorId": {"$ref": "common.schema.json#/$defs/semanticId"}, "kind": {"enum": ["distance", "horizontal-span", "vertical-span"]}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
