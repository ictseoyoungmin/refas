{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/whole-object-certificate.schema.json",
  "title": "RefAs whole-object certificate",
  "type": "object",
  "required": ["schema", "version", "projectId", "sourceSha256", "checkpointId", "checkpointDigest", "gateIds", "audit", "certificateDigest", "certifiedAt"],
  "properties": {
    "schema": {"const": "refas.whole-object-certificate/v1"},
    "version": {"const": "1.0.0"},
    "projectId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "sourceSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "checkpointId": {"type": "string", "pattern": "^cp_[a-f0-9]{20}$"},
    "checkpointDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "gateIds": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
    "audit": {
      "type": "object",
      "required": ["checkpointCount", "objectCount"],
      "properties": {"checkpointCount": {"type": "integer", "minimum": 1}, "objectCount": {"type": "integer", "minimum": 0}},
      "additionalProperties": false
    },
    "certificateDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "certifiedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
