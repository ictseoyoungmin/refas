{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/claim-certification-decision.schema.json",
  "title": "RefAs claim certification decision",
  "type": "object",
  "required": ["schema", "transaction", "policy", "claims", "authorizedClaimIds", "refusedClaimIds", "authorized", "decisionDigest"],
  "properties": {
    "schema": {"const": "refas.claim-certification-decision/v1"},
    "transaction": {
      "type": "object",
      "required": ["id", "transactionDigest", "candidateSha256", "checkpointId", "checkpointContentDigest"],
      "properties": {
        "id": {"type": "string", "pattern": "^ctx_[a-f0-9]{20}$"},
        "transactionDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "candidateSha256": {"$ref": "common.schema.json#/$defs/digest"},
        "checkpointId": {"type": "string", "pattern": "^cp_[a-f0-9]{20}$"},
        "checkpointContentDigest": {"$ref": "common.schema.json#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["id", "policyDigest"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/semanticId"},
        "policyDigest": {"$ref": "common.schema.json#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "required", "status", "obligationChecks", "matchedEvidenceNodeIds", "vetoFindings", "disclosedFindings"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/semanticId"},
          "required": {"type": "boolean"},
          "status": {"enum": ["pass", "fail"]},
          "obligationChecks": {"type": "array"},
          "matchedEvidenceNodeIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
          "vetoFindings": {"type": "array"},
          "disclosedFindings": {"type": "array"}
        },
        "additionalProperties": false
      }
    },
    "authorizedClaimIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
    "refusedClaimIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
    "authorized": {"type": "boolean"},
    "decisionDigest": {"$ref": "common.schema.json#/$defs/digest"}
  },
  "additionalProperties": false
}
