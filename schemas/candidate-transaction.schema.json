{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/candidate-transaction.schema.json",
  "title": "RefAs candidate provenance transaction",
  "type": "object",
  "required": ["schema", "status", "rootCandidate", "checkpoint", "evidenceNodes", "decisionNodeIds", "obligations", "obligationChecks", "policy", "id", "transactionDigest"],
  "properties": {
    "schema": {"const": "refas.candidate-transaction/v1"},
    "status": {"const": "SEALED"},
    "rootCandidate": {
      "type": "object",
      "required": ["sha256", "sizeBytes"],
      "properties": {
        "sha256": {"$ref": "common.schema.json#/$defs/digest"},
        "sizeBytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": ["checkpointId", "checkpointContentDigest", "candidateArtifactSha256"],
      "properties": {
        "checkpointId": {"type": "string", "pattern": "^cp_[a-f0-9]{20}$"},
        "checkpointContentDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "candidateArtifactSha256": {"$ref": "common.schema.json#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "evidenceNodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "schema", "artifactSha256", "sizeBytes", "subjectBinding", "dependsOn"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/semanticId"},
          "role": {"$ref": "common.schema.json#/$defs/semanticId"},
          "schema": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
          "artifactSha256": {"$ref": "common.schema.json#/$defs/digest"},
          "sizeBytes": {"type": "integer", "minimum": 1},
          "subjectBinding": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "pointer", "candidateSha256"],
                "properties": {
                  "kind": {"const": "json-pointer"},
                  "pointer": {"type": "string", "pattern": "^/"},
                  "candidateSha256": {"$ref": "common.schema.json#/$defs/digest"}
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["kind"],
                "properties": {"kind": {"const": "derived"}},
                "additionalProperties": false
              }
            ]
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/semanticId"}
          }
        },
        "additionalProperties": false
      }
    },
    "decisionNodeIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/semanticId"}
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "schema", "minCount"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/semanticId"},
          "role": {"anyOf": [{"$ref": "common.schema.json#/$defs/semanticId"}, {"type": "null"}]},
          "schema": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
          "minCount": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "obligationChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "matchingNodeIds", "pass"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/semanticId"},
          "matchingNodeIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
          "pass": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "object",
      "required": ["exactCandidateBytesAreBound", "exactCheckpointContentIsBound", "evidenceGraphMustBeAcyclic", "everyEvidenceNodeMustReachADecision", "everyEvidenceNodeMustResolveToRootCandidate", "evidenceRolesArePolicyInputsNotCertificationClaims", "transactionDoesNotMutateArtifacts", "transactionDoesNotAuthorizeCertification"],
      "properties": {
        "exactCandidateBytesAreBound": {"const": true},
        "exactCheckpointContentIsBound": {"const": true},
        "evidenceGraphMustBeAcyclic": {"const": true},
        "everyEvidenceNodeMustReachADecision": {"const": true},
        "everyEvidenceNodeMustResolveToRootCandidate": {"const": true},
        "evidenceRolesArePolicyInputsNotCertificationClaims": {"const": true},
        "transactionDoesNotMutateArtifacts": {"const": true},
        "transactionDoesNotAuthorizeCertification": {"const": true}
      },
      "additionalProperties": false
    },
    "id": {"type": "string", "pattern": "^ctx_[a-f0-9]{20}$"},
    "transactionDigest": {"$ref": "common.schema.json#/$defs/digest"}
  },
  "additionalProperties": false
}
