{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/external-construction-receipt.schema.json",
  "title": "RefAs attested external construction receipt",
  "type": "object",
  "required": [
    "schema",
    "rootScopeId",
    "scopeId",
    "sourceSha256",
    "vocabulary",
    "operation",
    "vocabularyDigest",
    "effectiveVocabularyDigest",
    "mechanicalDecompositionDigest",
    "permitDigest",
    "tool",
    "scriptSha256",
    "inputs",
    "determinism",
    "outputGlbSha256",
    "evidenceRefs",
    "policy",
    "receiptDigest"
  ],
  "properties": {
    "schema": {"const": "refas.external-construction-receipt/v1"},
    "rootScopeId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "scopeId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "sourceSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "vocabulary": {
      "enum": ["hard-surface", "organic", "mechanical-articulated", "hybrid", "unresolved"]
    },
    "operation": {"const": "external-construction"},
    "vocabularyDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "effectiveVocabularyDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "mechanicalDecompositionDigest": {
      "oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/digest"}]
    },
    "permitDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "tool": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/semanticId"},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "scriptSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "authority", "sha256"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/semanticId"},
          "kind": {"enum": ["source", "guide", "prior", "other"]},
          "authority": {"enum": ["observed", "inferred", "engineered"]},
          "sha256": {"$ref": "common.schema.json#/$defs/digest"}
        },
        "additionalProperties": false
      }
    },
    "determinism": {
      "type": "object",
      "required": ["mode"],
      "properties": {"mode": {"const": "byte-exact"}},
      "additionalProperties": false
    },
    "outputGlbSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "evidenceRefs": {"$ref": "common.schema.json#/$defs/evidenceRefs"},
    "policy": {
      "type": "object",
      "required": [
        "externalOutputRequiresReexecution",
        "receiptCannotAuthorizeWithoutProof",
        "priorCannotBecomeObservedSourceTruth"
      ],
      "properties": {
        "externalOutputRequiresReexecution": {"const": true},
        "receiptCannotAuthorizeWithoutProof": {"const": true},
        "priorCannotBecomeObservedSourceTruth": {"const": true}
      },
      "additionalProperties": false
    },
    "receiptDigest": {"$ref": "common.schema.json#/$defs/digest"}
  },
  "additionalProperties": false
}
