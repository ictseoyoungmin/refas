{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/parameter-fit-report.schema.json",
  "title": "RefAs evidence-bound parameter fit report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan", "planDigest", "ownerCapability", "scopeId", "sourceSha256", "baselineAssetSha256", "optimizer", "status", "stopReason", "evaluationCount", "baselineTrialId", "selectedTrialId", "objectiveImprovement", "trials", "policy", "reportDigest"],
  "properties": {
    "schema": {"const": "refas.parameter-fit-report/v1"},
    "plan": {"$ref": "parameter-fit-plan.schema.json"},
    "planDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "ownerCapability": {"const": "shape-reconstruction"},
    "scopeId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "sourceSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "baselineAssetSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "optimizer": {"type": "object"},
    "status": {"enum": ["IMPROVED", "NO_IMPROVEMENT"]},
    "stopReason": {"enum": ["evaluation-budget", "patience", "search-space-exhausted"]},
    "evaluationCount": {"type": "integer", "minimum": 1},
    "baselineTrialId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "selectedTrialId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "objectiveImprovement": {"type": "number"},
    "trials": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "policy": {"type": "object"},
    "reportDigest": {"$ref": "common.schema.json#/$defs/digest"}
  }
}
