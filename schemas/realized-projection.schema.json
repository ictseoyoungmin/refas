{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/realized-projection.schema.json",
  "title": "RefAs realized model-to-reference projection proof",
  "type": "object",
  "required": ["schema", "scopeId", "sourceSha256", "assetSha256", "cameraHypothesisId", "camera", "cameraDigest", "modelBindingDigest", "derivedAnchors", "projectionFit", "projectionFitDigest", "evidenceRefs", "policy", "realizedProjectionDigest"],
  "properties": {
    "schema": {"const": "refas.realized-projection/v1"},
    "scopeId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "sourceSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "assetSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "cameraHypothesisId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "camera": {"type": "object"},
    "cameraDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "modelBindingDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "derivedAnchors": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "derivedSegments": {"type": "array", "items": {"type": "object"}},
    "derivedInterfaces": {"type": "array", "items": {"type": "object"}},
    "segmentationMetrics": {
      "type": "object",
      "required": ["segmentCount", "materialSegmentMeanIoU", "interfaceBoundaryMeanErrorNormalized", "explicitOwnershipViolations"],
      "properties": {
        "segmentCount": {"type": "integer", "minimum": 0},
        "materialSegmentMeanIoU": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "interfaceBoundaryMeanErrorNormalized": {"type": ["number", "null"], "minimum": 0},
        "explicitOwnershipViolations": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "projectionFit": {"type": "object"},
    "projectionFitDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "evidenceRefs": {"type": "array", "items": {"type": "string"}},
    "policy": {"type": "object"},
    "realizedProjectionDigest": {"$ref": "common.schema.json#/$defs/digest"}
  },
  "additionalProperties": false
}
