{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/host-operation.schema.json",
  "title": "RefAs host operation",
  "type": "object",
  "required": ["schema","operationId","sessionId","projectId","requestDigest","mode","intent","inputDigest","status","startedAt","updatedAt","pauseRequestedAt","cancelRequestedAt","resumeCount","terminal"],
  "properties": {
    "schema": {"const":"refas.host-operation/v1"},
    "operationId": {"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{1,127}$"},
    "sessionId": {"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{1,127}$"},
    "projectId": {"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{1,127}$"},
    "requestDigest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "mode": {"enum":["mutating","read-only"]},
    "intent": {"type":"string","minLength":1,"maxLength":1000},
    "inputDigest": {"anyOf":[{"type":"null"},{"type":"string","pattern":"^[a-f0-9]{64}$"}]},
    "status": {"enum":["active","pausing","paused","resuming","cancelling","cancelled","completed","failed"]},
    "startedAt": {"type":"string","format":"date-time"},
    "updatedAt": {"type":"string","format":"date-time"},
    "pauseRequestedAt": {"anyOf":[{"type":"null"},{"type":"string","format":"date-time"}]},
    "cancelRequestedAt": {"anyOf":[{"type":"null"},{"type":"string","format":"date-time"}]},
    "resumeCount": {"type":"integer","minimum":0},
    "terminal": {
      "anyOf": [
        {"type":"null"},
        {
          "type":"object",
          "required":["status","headCheckpointId","errorCode"],
          "properties": {
            "status":{"enum":["cancelled","completed","failed"]},
            "headCheckpointId":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{1,127}$"}]},
            "errorCode":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{1,127}$"}]}
          },
          "additionalProperties":false
        }
      ]
    }
  },
  "additionalProperties":false
}
