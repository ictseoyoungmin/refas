{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/collision-model.schema.json",
  "title": "RefAs collision model",
  "type": "object",
  "required": ["schema", "scopeId", "sourceSha256", "identityBinding", "groups", "links", "policy", "collisionDigest"],
  "properties": {
    "schema": {"const": "refas.collision-model/v1"},
    "scopeId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "sourceSha256": {"$ref": "common.schema.json#/$defs/digest"},
    "identityBinding": {
      "type": "object",
      "required": ["schema", "sourceSchema", "projectionDigest"],
      "properties": {
        "schema": {"const": "refas.physical-collision-identity-binding/v1"},
        "sourceSchema": {"const": "refas.physical-identity-graph/v1"},
        "projectionDigest": {"$ref": "common.schema.json#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/semanticId"}
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/linkCollision"}
    },
    "policy": {
      "type": "object",
      "required": [
        "rigidLinkIdentityRequired",
        "scopedIdentityBinding",
        "collisionIdentityIndependentFromRenderIdentity",
        "visualReuseRequiresExplicitDeclaration",
        "backendFilterIndicesAreNotSemantic",
        "colliderFramesAreLinkLocal",
        "colliderFramesHaveNoScale",
        "semanticAuthorityRemainsExternal"
      ],
      "properties": {
        "rigidLinkIdentityRequired": {"const": true},
        "scopedIdentityBinding": {"const": true},
        "collisionIdentityIndependentFromRenderIdentity": {"const": true},
        "visualReuseRequiresExplicitDeclaration": {"const": true},
        "backendFilterIndicesAreNotSemantic": {"const": true},
        "colliderFramesAreLinkLocal": {"const": true},
        "colliderFramesHaveNoScale": {"const": true},
        "semanticAuthorityRemainsExternal": {"const": true}
      },
      "additionalProperties": false
    },
    "collisionDigest": {"$ref": "common.schema.json#/$defs/digest"}
  },
  "$defs": {
    "frame": {
      "type": "object",
      "required": ["translation_m", "rotation_quat_xyzw"],
      "properties": {
        "translation_m": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
          "items": false
        },
        "rotation_quat_xyzw": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "filter": {
      "type": "object",
      "required": ["groupIds", "maskGroupIds"],
      "properties": {
        "groupIds": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/semanticId"}
        },
        "maskGroupIds": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/semanticId"}
        }
      },
      "additionalProperties": false
    },
    "visualGeometryRef": {
      "type": "object",
      "required": ["geometryId", "geometryDigest"],
      "properties": {
        "geometryId": {"$ref": "common.schema.json#/$defs/semanticId"},
        "geometryDigest": {"$ref": "common.schema.json#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "boxGeometry": {
      "type": "object",
      "required": ["kind", "size_m"],
      "properties": {
        "kind": {"const": "BOX"},
        "size_m": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "number", "exclusiveMinimum": 0}
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "sphereGeometry": {
      "type": "object",
      "required": ["kind", "radius_m"],
      "properties": {
        "kind": {"const": "SPHERE"},
        "radius_m": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "capsuleGeometry": {
      "type": "object",
      "required": ["kind", "radius_m", "segmentLength_m"],
      "properties": {
        "kind": {"const": "CAPSULE"},
        "radius_m": {"type": "number", "exclusiveMinimum": 0},
        "segmentLength_m": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "cylinderGeometry": {
      "type": "object",
      "required": ["kind", "radius_m", "height_m"],
      "properties": {
        "kind": {"const": "CYLINDER"},
        "radius_m": {"type": "number", "exclusiveMinimum": 0},
        "height_m": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "convexHullGeometry": {
      "type": "object",
      "required": ["kind", "vertices_m"],
      "properties": {
        "kind": {"const": "CONVEX_HULL"},
        "vertices_m": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "array",
            "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
            "items": false
          }
        }
      },
      "additionalProperties": false
    },
    "meshGeometry": {
      "type": "object",
      "required": ["kind", "meshId", "geometryDigest", "reuseMode", "visualGeometryRef"],
      "properties": {
        "kind": {"const": "MESH"},
        "meshId": {"$ref": "common.schema.json#/$defs/semanticId"},
        "geometryDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "reuseMode": {"enum": ["COLLISION_ONLY", "DECLARED_VISUAL_REUSE"]},
        "visualGeometryRef": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/visualGeometryRef"}
          ]
        }
      },
      "additionalProperties": false
    },
    "geometry": {
      "oneOf": [
        {"$ref": "#/$defs/boxGeometry"},
        {"$ref": "#/$defs/sphereGeometry"},
        {"$ref": "#/$defs/capsuleGeometry"},
        {"$ref": "#/$defs/cylinderGeometry"},
        {"$ref": "#/$defs/convexHullGeometry"},
        {"$ref": "#/$defs/meshGeometry"}
      ]
    },
    "collider": {
      "type": "object",
      "required": ["id", "frame", "geometry", "filter", "authoritySubjectId"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/semanticId"},
        "frame": {"$ref": "#/$defs/frame"},
        "geometry": {"$ref": "#/$defs/geometry"},
        "filter": {"$ref": "#/$defs/filter"},
        "authoritySubjectId": {"$ref": "common.schema.json#/$defs/semanticId"}
      },
      "additionalProperties": false
    },
    "linkCollision": {
      "type": "object",
      "required": ["linkId", "selfCollisionPolicy", "filterAuthoritySubjectId", "colliders"],
      "properties": {
        "linkId": {"$ref": "common.schema.json#/$defs/semanticId"},
        "selfCollisionPolicy": {"enum": ["ENABLED", "DISABLED"]},
        "filterAuthoritySubjectId": {"$ref": "common.schema.json#/$defs/semanticId"},
        "colliders": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/collider"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
