{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/fusion-provenance.schema.json",
  "title": "RefAs fusion provenance",
  "type": "object",
  "required": ["schema", "planDigest", "groupId", "fusionRootId", "outputMeshDigest", "sourceMemberIds", "outputFaces", "removedInterfaces", "reopen", "policy", "provenanceDigest"],
  "properties": {
    "schema": {"const": "refas.fusion-provenance/v1"},
    "planDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "groupId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "fusionRootId": {"$ref": "common.schema.json#/$defs/semanticId"},
    "outputMeshDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "sourceMemberIds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
    "outputFaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["outputFaceIndex", "sourceMemberIds", "sourceFaceRefs", "origin"],
        "properties": {
          "outputFaceIndex": {"type": "integer", "minimum": 0},
          "sourceMemberIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
          "sourceFaceRefs": {"type": "array", "items": {"type": "object"}},
          "origin": {"enum": ["preserved", "weld-generated", "boolean-generated"]}
        },
        "additionalProperties": false
      }
    },
    "removedInterfaces": {"type": "array", "items": {"type": "object"}},
    "reopen": {
      "type": "object",
      "required": ["checkpointId", "stateDigest", "inputAssetSha256", "canonicalSource"],
      "properties": {
        "checkpointId": {"$ref": "common.schema.json#/$defs/semanticId"},
        "stateDigest": {"$ref": "common.schema.json#/$defs/digest"},
        "inputAssetSha256": {"$ref": "common.schema.json#/$defs/digest"},
        "canonicalSource": {"const": "pre-fusion-semantic-state"}
      },
      "additionalProperties": false
    },
    "policy": {"type": "object"},
    "provenanceDigest": {"$ref": "common.schema.json#/$defs/digest"}
  },
  "additionalProperties": false
}
