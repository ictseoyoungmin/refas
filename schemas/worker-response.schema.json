{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refas.dev/schemas/worker-response.schema.json",
  "title": "RefAs external worker completion response",
  "type": "object",
  "required": ["schema", "workerRunId", "operationId", "requestDigest", "status", "message", "artifactRefs"],
  "properties": {
    "schema": {"const": "refas.worker-response/v1"},
    "workerRunId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"},
    "operationId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"},
    "requestDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "completed"},
    "message": {"anyOf": [{"type": "null"}, {"type": "string", "maxLength": 1000}]},
    "artifactRefs": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/contentReference"}}
  },
  "$defs": {
    "contentReference": {
      "type": "object",
      "required": ["schema", "kind", "path", "sha256", "sizeBytes"],
      "properties": {
        "schema": {"const": "refas.content-reference/v1"},
        "kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sizeBytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
